# Database
POSTGRES_DB=gsm_news
POSTGRES_USER=gsm_user
POSTGRES_PASSWORD=
DATABASE_URL=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
SETTINGS_ENCRYPTION_KEY=

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=GSM

# S3 Storage
S3_ENDPOINT=https://example-s3.local
S3_REGION=us-east-1
S3_BUCKET=example-bucket
S3_BASE_URL=https://example-s3.local/example-bucket
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=false

# Strapi MySQL (for migration)
STRAPI_DB_HOST=
STRAPI_DB_PORT=3306
STRAPI_DB_USER=
STRAPI_DB_PASSWORD=
STRAPI_DB_NAME=

# Upload
UPLOAD_DIR=/path/to/uploads
MAX_FILE_SIZE=10485760

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
