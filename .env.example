# Database
DATABASE_URL=postgresql://user:password@localhost:5432/gsm_news

# NextAuth
NEXTAUTH_URL=https://gsmblog.gsm.ir
NEXTAUTH_SECRET=your-secret-key-here

# Admin
ADMIN_EMAIL=admin@gsm.ir
ADMIN_PASSWORD=change-me-in-production

# Site
NEXT_PUBLIC_SITE_URL=https://gsmblog.gsm.ir
NEXT_PUBLIC_SITE_NAME=GSM

# S3 Storage
S3_ENDPOINT=https://s3.gsm.ir
S3_BUCKET=gsmblog-production
S3_BASE_URL=https://s3.gsm.ir/gsmblog-production
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Strapi MySQL (for migration)
STRAPI_DB_HOST=172.30.3.230
