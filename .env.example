STRAPI_DB_USER=p.mansouri
STRAPI_DB_PASSWORD=JFtrUKEmmccN
STRAPI_DB_NAME=blog_gsm_production

# Upload
UPLOAD_DIR=/var/www/gsm/uploads
MAX_FILE_SIZE=10485760

# SMTP (optional)
